# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=FarmGridAI.settings.development

# ---------------------------------------------------------------------------
# Database (sqlite | postgres)
# ---------------------------------------------------------------------------
DB_ENGINE=sqlite
DB_NAME=FarmGridAI
DB_USER=khetsathi
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ---------------------------------------------------------------------------
# JWT / auth
# ---------------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_ALL_ORIGINS=false

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_UPLOAD_FILE_SIZE_MB=10

# ---------------------------------------------------------------------------
# Celery / Redis (leave eager in dev so no Redis is required)
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=true

# ---------------------------------------------------------------------------
# ML / AI
# ---------------------------------------------------------------------------
ML_EQUIPMENT_CLASSIFIER_WEIGHTS=
ML_EQUIPMENT_CLASSIFIER_ARCH=mobilenet_v3_large
ML_EQUIPMENT_CLASSIFIER_ARTIFACT_DIR=
ML_EQUIPMENT_CLASSIFIER_ARTIFACT_FILE=equipment_classifier_mobilenetv3_top6_v1.pt
ML_EQUIPMENT_CLASSIFIER_UNKNOWN_THRESHOLD=0.55
ML_EQUIPMENT_CLASSIFIER_ACTIVATION_MACRO_F1=0.70
OCR_LIBRARY=auto

# ---------------------------------------------------------------------------
# Optional LLM (chatbot RAG layer)
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=
CHATBOT_LLM_ENABLED=false

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@khetsathi.example

# ---------------------------------------------------------------------------
# Localization
# ---------------------------------------------------------------------------
LANGUAGE_CODE=en
TIME_ZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Data ingestion (network is OFF by default; keep it off unless a human
# operator explicitly approves a host-locked, budgeted collection/compliance run)
# ---------------------------------------------------------------------------
DATA_INGESTION_NETWORK_ALLOWED=false
DATA_INGESTION_USER_AGENT=KhetSathiAI-ResearchBot/1.0 (+{contact})
DATA_INGESTION_CONTACT_EMAIL=
DATA_INGESTION_HTTP_TIMEOUT=15
DATA_INGESTION_MAX_ARTIFACT_SIZE_MB=25
DATA_INGESTION_MAX_IMAGE_SIZE_MB=15
DATA_INGESTION_MIN_IMAGE_DIMENSION=320
DATA_INGESTION_DEFAULT_RATE_LIMIT=10
DATA_INGESTION_DEFAULT_REQUEST_DELAY=1.0
DATA_INGESTION_ROBOTS_USER_AGENT=KhetSathiAIResearchBot